{
  "name": "connect24/sample-order-notifications",
  "description": "Realistic Connect24 sample: order-shipped notifications with idempotent retries, suppression handling and tests.",
  "license": "MIT",
  "repositories": [
    {
      "type": "path",
      "url": "../.."
    }
  ],
  "require": {
    "php": ">=8.1",
    "connect24/connect24": "*@dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Connect24\\Samples\\OrderNotifications\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Connect24\\Samples\\OrderNotifications\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests"
  }
}
